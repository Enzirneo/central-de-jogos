<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A permissão INTERNET é necessária pro dev: o Flutter usa pra hot reload,
         breakpoints, etc. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Só no build de debug: libera HTTP/ws sem TLS pra falar com o servidor
         local (ws://10.0.2.2:2567). Em release o tráfego continua exigindo TLS. -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute" />
</manifest>
