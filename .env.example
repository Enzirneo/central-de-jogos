# Copie este arquivo para ".env" e ajuste os valores se necessário.
# Usado tanto pelo docker-compose.yml quanto pelo servidor (apps/server).

# --- Servidor ---
PORT=2567

# --- PostgreSQL ---
# String de conexão usada pelo servidor (host "postgres" = nome do serviço no docker-compose)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/central_de_jogos
# Variáveis usadas pela própria imagem oficial do Postgres para criar o banco inicial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=central_de_jogos

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
